{
    "image":"mcr.microsoft.com/devcontainers/dotnet:10.0",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/${localWorkspaceFolderBasename},type=bind,consistency=cached,relabel=private",
    "workspaceFolder": "/workspace/${localWorkspaceFolderBasename}",
    "updateRemoteUserUID": false,
    "features": {
        "ghcr.io/devcontainers-extra/features/neovim-homebrew": {
            "cashbuster": "0.12.4"
        },
        "ghcr.io/devcontainers-extra/features/ripgrep": {},
        "ghcr.io/devcontainers-extra/features/opencode": {},
        "ghcr.io/devcontainer-community/devcontainer-features/tree-sitter:1": {}
    },
    "forwardPorts": [],
    "portsAttributes": {
    },
    "runArgs": [
        "--network", "host",
        "--userns=keep-id"
    ],
    "initializeCommand": "bash scripts/sync-nvim-config.sh",
    "postCreateCommand": "bash scripts/install-nvim-config.sh",
    "mounts": [
        "source=${localWorkspaceFolder}/.config/nvim-data,target=/home/vscode/.config/nvim-data,type=bind,consistency=cached,relabel=private",
        "source=.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached,relabel=private"
    ],
}
